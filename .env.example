# BotzBuddy Environment Variables Example
PORT=3000

# LLM Providers (all optional — BotzBuddy runs fully rule-based without them)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini        # configurable; use any current OpenAI chat model
GENERAL_STEM_MODE=on            # on | off (server default; plugin can override)

# Optional MongoDB persistence for the Curiosity Jar (requires: pip install pymongo)
# MONGODB_URI=mongodb://localhost:27017/botzbuddy

# Allowed CORS Origins (defaults to * if unset)
ALLOWED_ORIGINS=*
